# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL – required; no SQLite for the running app)
# Docker: postgres/postgres/tourist_assistant. Local: set POSTGRES_USER/POSTGRES_DB to match your DB.
DATABASE_URL=postgres://postgres:postgres@db:5432/tourist_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tourist_assistant

# Object storage backend: local | minio | s3
# local = filesystem (backend/media/) — default for non-Docker dev
# minio = S3-compatible MinIO — default for Docker Compose
# s3 = Amazon S3 — optional production backend
MEDIA_STORAGE_BACKEND=minio

# Legacy flag (still supported): USE_S3_MEDIA=true selects minio when MEDIA_STORAGE_BACKEND is unset
# USE_S3_MEDIA=true

# MinIO (when MEDIA_STORAGE_BACKEND=minio)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=media

# Amazon S3 (when MEDIA_STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-2
# AWS_S3_CUSTOM_DOMAIN=          # optional CloudFront or custom domain

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
